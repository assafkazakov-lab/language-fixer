{
  "manifest_version": 3,
  "name": "Language Fixer",
  "version": "1.1.0",
  "description": "Fix text typed with the wrong keyboard language — converts Hebrew↔English in any text field without changing your OS layout.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Language Fixer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "flip-language": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Flip selected text (or the word at the cursor) between Hebrew and English"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ngrams.js", "detect.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
